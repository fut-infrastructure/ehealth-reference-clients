# Optional overrides for `docker compose -f deploy/docker-compose.yml up`.
# Defaults are baked into the compose file, so no .env is required for first
# run. Copy to `.env` and pass via `--env-file .env` only when you need to
# override.
#
# Pointed at the inttest environment. ehealth-reference-clinician-client and
# ehealth-reference-citizen-client are pre-provisioned on all FUT non-prod
# environments (see docs/onboarding/connect-to-test.md); this file is tracked
# in git, so CLIENT_SECRET stays blank here. Fill it in locally without
# staging or committing it.
EHEALTH_ISSUER_URI=https://saml.inttest.ehealth.sundhed.dk/auth/realms/ehealth
EHEALTH_CLIENT_ID=ehealth-reference-clinician-client
EHEALTH_CLIENT_SECRET=

EHEALTH_CITIZEN_ISSUER_URI=https://saml.inttest.ehealth.sundhed.dk/auth/realms/nemlogin
EHEALTH_CITIZEN_CLIENT_ID=ehealth-reference-citizen-client

FHIR_SERVER_PATIENT=https://patient.inttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_CARE_PLAN=https://careplan.inttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_PLAN=https://plan.inttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_ORGANIZATION=https://organization.inttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_TERMINOLOGY=https://terminology.inttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_MEASUREMENT=https://measurement.inttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_TASK=https://task.inttest.ehealth.sundhed.dk/fhir