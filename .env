# Optional overrides for `docker compose -f deploy/docker-compose.yml up`.
# Defaults are baked into the compose file, so no .env is required for first
# run. Copy to `.env` and pass via `--env-file .env` only when you need to
# override.

EHEALTH_ISSUER_URI=https://saml.exttest.ehealth.sundhed.dk/auth/realms/ehealth
EHEALTH_CLIENT_ID=ehealth-reference-clinician-client

# Still need a login, this secret lets you get to the client login screen.
EHEALTH_CLIENT_SECRET=YpqaFKdFqpAcQhlTVEGa

EHEALTH_CITIZEN_ISSUER_URI=https://saml.exttest.ehealth.sundhed.dk/auth/realms/nemlogin
EHEALTH_CITIZEN_CLIENT_ID=ehealth-reference-citizen-client

FHIR_SERVER_PATIENT=https://patient.exttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_CARE_PLAN=https://careplan.exttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_PLAN=https://plan.exttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_ORGANIZATION=https://organization.exttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_TERMINOLOGY=https://terminology.exttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_MEASUREMENT=https://measurement.exttest.ehealth.sundhed.dk/fhir
FHIR_SERVER_TASK=https://task.exttest.ehealth.sundhed.dk/fhir
